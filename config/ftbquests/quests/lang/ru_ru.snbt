	"chapter.289CB31B126BD56F.title": "Бог"
	"quest.7F8EE563F826A03B.title": "Алтарь"
	"quest.7F8EE563F826A03B.quest_desc": [
		"Алтарь — блок магнетита; у него бог чаще отвечает на молитвы, и на нём приносят дары."
		""
		"Справочник: Бог и вера (книга — команда /guide)"
	]
	"quest.4A4D3338C4B4E14B.title": "Молитва"
	"quest.4A4D3338C4B4E14B.quest_desc": [
		"Начни молитву с обращения («Боже», «Господи»…) — в чате или голосом. У алтаря (не дальше 6 блоков) бог отвечает охотнее. Отметь квест вручную."
		""
		"Справочник: Бог и вера (книга — команда /guide)"
	]
	"quest.007FC336F850BE65.title": "Дар"
	"quest.007FC336F850BE65.quest_desc": [
		"Принеси дар на алтарь: ПКМ предметом по алтарю. Хлеб и пшеница дают +1 веры, изумруд +3, алмаз +5. Отметь квест вручную."
		""
		"Справочник: Бог и вера (книга — команда /guide)"
	]
	"quest.7EA7101F3EA72AC6.title": "Знамение"
	"quest.7EA7101F3EA72AC6.quest_desc": [
		"Верным бог посылает знамения — гром, колокольный звон, звёздный свет, молнию (она не ранит). Отметь квест вручную, когда увидишь знамение."
		""
		"Справочник: Бог и вера (книга — команда /guide)"
	]
	"quest.609B4A61548D9D74.title": "Благословение"
	"quest.609B4A61548D9D74.quest_desc": [
		"Ещё верным бог посылает благословения — регенерацию, скорость, силу в работе, удачу, защиту, сытость, ночное зрение и другие. Отметь квест вручную, когда получишь благословение."
		""
		"Справочник: Бог и вера (книга — команда /guide)"
	]
}
