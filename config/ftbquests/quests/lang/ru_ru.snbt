{
	"file.7912F5808CB29691.title": "Живой мир"
	"chapter.73FEE18A96B01016.title": "Первые шаги"
	"quest.1999FE22DAB27518.title": "Стартовый лагерь"
	"quest.1999FE22DAB27518.quest_desc": [
		"Лагерь выдаётся при первом входе вместе с книгой. Не ставь его вплотную к деревне: ближе 20 блоков к её границе появится предупреждение."
		""
		"Справочник: Путь правителя → Твоя колония (книга — команда /guide)"
	]
	"quest.2EF0C4F6BA01DDD6.title": "Знакомство"
	"quest.2EF0C4F6BA01DDD6.quest_desc": [
		"Нажми ПКМ по жителю деревни и поговори с ним. У каждого есть имя, характер и сердца — его отношение к тебе."
		""
		"Справочник: Путь правителя → Деревня и жители (книга — команда /guide)"
	]
	"quest.47BFF2BCC859CAD8.title": "Первый изумруд"
	"quest.47BFF2BCC859CAD8.quest_desc": [
		"Продай жителю что-нибудь или возьми задание с доски объявлений. Изумруды — валюта деревни."
		""
		"Справочник: Путь правителя → Экономика и торговля (книга — команда /guide)"
	]
	"quest.2FC3A81E913734E1.title": "Доска заданий"
	"quest.2FC3A81E913734E1.quest_desc": [
		"В деревнях стоят доски объявлений: нажми ПКМ по доске. За поручения платят изумрудами."
		""
		"Справочник: Путь правителя → Экономика и торговля (книга — команда /guide)"
	]
	"quest.6AD014DBA3B0F61A.title": "Инструмент строителя"
	"quest.6AD014DBA3B0F61A.quest_desc": [
		"В стартовом лагере есть сундуки с припасами, ратушей и инструментом строителя — им ставят постройки колонии."
		""
		"Справочник: Путь правителя → Твоя колония (книга — команда /guide)"
	]
	"quest.5BA242BA92C66780.title": "Первая ратуша"
	"quest.5BA242BA92C66780.quest_desc": [
		"Поставь ратушу — так рождается колония, и в неё сразу придут первые колонисты. Отметь квест вручную, когда ратуша стоит."
		""
		"Справочник: Путь правителя → Твоя колония (книга — команда /guide)"
	]
	"quest.422BE98F9FFBD028.title": "Хлеб насущный"
	"quest.422BE98F9FFBD028.quest_desc": [
		"Собери пшеницу и испеки хлеб. Сытый путник сильнее голодного."
		""
		"Справочник: Хозяйство и кухня (книга — команда /guide)"
	]
	"quest.2D0D0D9D5D247C02.title": "Защитник"
	"quest.2D0D0D9D5D247C02.quest_desc": [
		"Ночь опасна. Выкуй железный меч — без защиты из деревни лучше не выходить."
		""
		"Справочник: Искатель приключений → Бой, оружие и броня (книга — команда /guide)"
	]
	"quest.058F06583463DCDA.title": "Охота на чудовищ"
	"quest.058F06583463DCDA.quest_desc": [
		"Сними первого зомби у стен деревни."
		""
		"Справочник: Искатель приключений → Бой, оружие и броня (книга — команда /guide)"
	]
	"quest.694439E53E153453.title": "Путь выбран"
	"quest.694439E53E153453.quest_desc": [
		"Открой в книге «Карту пути» и выбери направление: правитель, инженер, искатель или хозяин. Отметь квест вручную — откроются остальные главы."
		""
		"Справочник: Карта пути (книга — команда /guide)"
	]
	"chapter.0C9C5350D528AC8E.title": "Правитель"
	"quest.64A6D67E9082EADE.title": "Семейное древо"
	"quest.64A6D67E9082EADE.quest_desc": [
		"Семейное древо показывает родню жителей деревни: кто кому родич."
		""
		"Справочник: Путь правителя → Люди и семьи (MCA) (книга — команда /guide)"
	]
	"quest.57DD1A2A24538C1C.title": "Кольцо свахи"
	"quest.57DD1A2A24538C1C.quest_desc": [
		"Кольцо свахи (из железа) не для тебя — оно женит пару жителей между собой. Колец нужно два, по одному на каждого; уже женатые откажутся."
		""
		"Справочник: Путь правителя → Люди и семьи (MCA) (книга — команда /guide)"
	]
	"quest.251640809A8C2A54.title": "Кольцо для помолвки"
	"quest.251640809A8C2A54.quest_desc": [
		"Помолвочное кольцо — золотой слиток и алмаз. С ним можно обручиться с тем, к кому у тебя достаточно сердец."
		""
		"Справочник: Путь правителя → Люди и семьи (MCA) (книга — команда /guide)"
	]
	"quest.2BE34388AD810557.title": "Свадьба"
	"quest.2BE34388AD810557.quest_desc": [
		"Обручальное кольцо (из золотых слитков) позволяет вступить в брак при достаточном числе сердец. Квест засчитается, когда сыграешь свадьбу."
		""
		"Справочник: Путь правителя → Люди и семьи (MCA) (книга — команда /guide)"
	]
	"quest.4862A411E8D236DE.title": "Первый рабочий"
	"quest.4862A411E8D236DE.quest_desc": [
		"Найми первого рабочего и дострой его постройку — колония оживает. Отметь квест вручную."
		""
		"Справочник: Путь правителя → Твоя колония (книга — команда /guide)"
	]
	"quest.7806F37AF786449B.title": "Переселение"
	"quest.7806F37AF786449B.quest_desc": [
		"Приглашение в колонию — бумага, изумруд и перо. ПКМ приглашением по жителю деревни, который тебе доверяет, — и он переедет в твою колонию. Отметь квест вручную, когда первый житель переселится."
		""
		"Справочник: Путь правителя → Деревня и колония вместе (книга — команда /guide)"
	]
	"quest.0C8E601D5C3D43E7.title": "Рекрут"
	"quest.0C8E601D5C3D43E7.quest_desc": [
		"Нажми ПКМ по рекруту и выбери «Нанять» — простой рекрут стоит 8 изумрудов. Жалованье — 1 изумруд каждые 20 минут с бойца. Отметь квест вручную."
		""
		"Справочник: Путь правителя → Рекруты и армия (книга — команда /guide)"
	]
	"quest.62A6B429EE33DA19.title": "Отряд"
	"quest.62A6B429EE33DA19.quest_desc": [
		"Три рекрута под рукой — уже отряд. Плату они берут из своего инвентаря или из сундука обеспечения: держи там изумруды и еду. Отметь квест вручную."
		""
		"Справочник: Путь правителя → Рекруты и армия (книга — команда /guide)"
	]
	"quest.1E6EA6BA3BE3C362.title": "Банковский терминал"
	"quest.1E6EA6BA3BE3C362.quest_desc": [
		"Банковский терминал Numismatics — счета, карты и обмен в одном блоке. Монеты — валюта между игроками; жители по-прежнему берут изумруды."
		""
		"Справочник: Инженер: с чего начать → Электричество и валюта Create (книга — команда /guide)"
	]
	"quest.2DE6EE9A5BFB0492.title": "Казна колонии"
	"quest.2DE6EE9A5BFB0492.quest_desc": [
		"War 'N Taxes: постройки колонии приносят налог в казну, а политики меняют правила. Прочитай раздел о казне и налогах и отметь квест вручную."
		""
		"Справочник: Путь правителя → Казна и налоги (книга — команда /guide)"
	]
	"quest.628F37C6F53A9A5F.title": "Первый налог"
	"quest.628F37C6F53A9A5F.quest_desc": [
		"Забери налог из казны командой /wnt claimtax. Отметь квест вручную."
		""
		"Справочник: Путь правителя → Казна и налоги (книга — команда /guide)"
	]
	"quest.11688C7516E3CD9B.title": "Голос жителей"
	"quest.11688C7516E3CD9B.quest_desc": [
		"Зажми клавишу Push-to-Talk и заговори с жителем вслух — жители и колонисты слышат и отвечают. Отметь квест вручную."
		""
		"Справочник: Путь правителя → Голос жителей (книга — команда /guide)"
	]
	"quest.615164E233A61B66.title": "Война"
	"quest.615164E233A61B66.quest_desc": [
		"Проведи набег на чужую казну или отрази осаду. Слава и трофеи — или разорение. Отметь квест вручную."
		""
		"Справочник: Путь правителя → Война (книга — команда /guide)"
	]
	"quest.01B3218E23E6CCCC.title": "Корона"
	"quest.01B3218E23E6CCCC.quest_desc": [
		"С репутацией растёт твой ранг в деревне: Крестьянин → Торговец → Дворянин → Мэр → Монарх. Для высших рангов деревня должна быть хорошо отстроена."
		""
		"Справочник: Путь правителя → Деревня и жители (книга — команда /guide)"
	]
	"chapter.303EB50EAF2D4C54.title": "Инженер"
	"quest.6D6BD4277098B710.title": "Гаечный ключ"
	"quest.6D6BD4277098B710.quest_desc": [
		"Ключ собирает и разбирает механизмы Create — без него машин не починить."
		""
		"Справочник: Инженер: с чего начать → Create: кинетика (книга — команда /guide)"
	]
	"quest.2075526AC5E72D83.title": "Рукоятка"
	"quest.2075526AC5E72D83.quest_desc": [
		"Рукоятка даёт первое вращение: ПКМ крутит в одну сторону, Shift+ПКМ — в другую."
		""
		"Справочник: Инженер: с чего начать → Create: кинетика (книга — команда /guide)"
	]
	"quest.050AD02303EE9046.title": "Шестерни"
	"quest.050AD02303EE9046.quest_desc": [
		"Шестерни передают вращение дальше, от механизма к механизму."
		""
		"Справочник: Инженер: с чего начать → Create: кинетика (книга — команда /guide)"
	]
	"quest.41B9745B9286A9D6.title": "Вал"
	"quest.41B9745B9286A9D6.quest_desc": [
		"Вал передаёт вращение по прямой — соедини им механизмы."
		""
		"Справочник: Инженер: с чего начать → Create: кинетика (книга — команда /guide)"
	]
	"quest.5E818BE1A845E675.title": "Осмий"
	"quest.5E818BE1A845E675.quest_desc": [
		"Осмий — основа машин Mekanism: добывай руду и переплавляй в слитки."
		""
		"Справочник: Инженер: с чего начать → Mekanism: машины и химия (книга — команда /guide)"
	]
	"quest.2C982DEB8E133B1E.title": "Металлургический наполнитель"
	"quest.2C982DEB8E133B1E.quest_desc": [
		"Печка, железо, осмий и редстоун — ключ к механике Mekanism."
		""
		"Справочник: Инженер: с чего начать → Mekanism: машины и химия (книга — команда /guide)"
	]
	"quest.7429BACFCC067AB5.title": "Камера обогащения"
	"quest.7429BACFCC067AB5.quest_desc": [
		"Стальной корпус и базовые сплавы: удвоение руды и первые цепочки."
		""
		"Справочник: Инженер: с чего начать → Mekanism: машины и химия (книга — команда /guide)"
	]
	"quest.32FA79948ED96CDA.title": "Энергокуб"
	"quest.32FA79948ED96CDA.quest_desc": [
		"Накопи энергию — машинам нужно питание."
		""
		"Справочник: Инженер: с чего начать → Mekanism: машины и химия (книга — команда /guide)"
	]
	"quest.53030D219C0FF6B3.title": "Зарядник"
	"quest.53030D219C0FF6B3.quest_desc": [
		"Железо и медь: зарядник заряжает кристаллы истинного кварца."
		""
		"Справочник: Инженер: с чего начать → AE2: ME-сеть и автокрафт (книга — команда /guide)"
	]
	"quest.08F0EE3C135747BB.title": "Высекатель"
	"quest.08F0EE3C135747BB.quest_desc": [
		"Высекай процессоры — мозг будущей ME-сети."
		""
		"Справочник: Инженер: с чего начать → AE2: ME-сеть и автокрафт (книга — команда /guide)"
	]
	"quest.41EE284E234C59A5.title": "МЭ-накопитель"
	"quest.41EE284E234C59A5.quest_desc": [
		"Первый накопитель МЭ: хранение и учёт каждой вещи."
		""
		"Справочник: Инженер: с чего начать → AE2: ME-сеть и автокрафт (книга — команда /guide)"
	]
	"quest.5BE2539A1EA8EA8F.title": "Ячейка 1К"
	"quest.5BE2539A1EA8EA8F.quest_desc": [
		"Ячейка хранения вмещает и упорядочивает твои ресурсы."
		""
		"Справочник: Инженер: с чего начать → AE2: ME-сеть и автокрафт (книга — команда /guide)"
	]
	"quest.375A9EA74161BE29.title": "Воздушный компрессор"
	"quest.375A9EA74161BE29.quest_desc": [
		"Укреплённые кирпичи, печка и напорная труба нагнетают давление."
		""
		"Справочник: Инженер: с чего начать → Пневматика: сжатый воздух (книга — команда /guide)"
	]
	"quest.533D948C7234E472.title": "Дрон"
	"quest.533D948C7234E472.quest_desc": [
		"Запрограммированный дрон — летающий помощник на заданиях."
		""
		"Справочник: Инженер: с чего начать → Пневматика: сжатый воздух (книга — команда /guide)"
	]
	"quest.6CBAF14C3E4E2FDC.title": "Рельсы"
	"quest.6CBAF14C3E4E2FDC.quest_desc": [
		"Первые рельсы — путь для вагонеток и паровоза."
		""
		"Справочник: Инженер: с чего начать → Железные дороги (книга — команда /guide)"
	]
	"quest.0CFCB817B0930F09.title": "Паровоз"
	"quest.0CFCB817B0930F09.quest_desc": [
		"Паровоз возит грузы по рельсам — твоя железная дорога."
		""
		"Справочник: Инженер: с чего начать → Железные дороги (книга — команда /guide)"
	]
	"quest.3BB9ED40AA25F49F.title": "Компьютер"
	"quest.3BB9ED40AA25F49F.quest_desc": [
		"Программируемый компьютер на Lua: от простых скриптов до управления машинами."
		""
		"Справочник: Инженер: с чего начать → Компьютеры: CC: Tweaked и периферия (книга — команда /guide)"
	]
	"quest.2C6E63547FCCD0B7.title": "Колония через сеть"
	"quest.2C6E63547FCCD0B7.quest_desc": [
		"Жезл ColonyLink связывает стройку колонии с автокрафтом ME-сети."
		""
		"Справочник: Инженер: с чего начать → Мосты: Mekanism×AE2 и колония (книга — команда /guide)"
	]
	"quest.1659350DCA46DED2.title": "Газ в сети"
	"quest.1659350DCA46DED2.quest_desc": [
		"Химическая ячейка переносит газы Mekanism в ME-сеть."
		""
		"Справочник: Инженер: с чего начать → Мосты: Mekanism×AE2 и колония (книга — команда /guide)"
	]
	"chapter.5BF9DA83CB7B385C.title": "Искатель"
	"quest.1767C5FB5A38DA58.title": "Веха"
	"quest.1767C5FB5A38DA58.quest_desc": [
		"Путеводный обелиск — точка быстрой телепортации и возврата из походов."
		""
		"Справочник: Быт → Путешествия (книга — команда /guide)"
	]
	"quest.313A22DABB484DE7.title": "Дальняя дорога"
	"quest.313A22DABB484DE7.quest_desc": [
		"Телепортируйся через веху — мир стал ближе. Отметь квест вручную."
		""
		"Справочник: Быт → Путешествия (книга — команда /guide)"
	]
	"quest.6182DEAE7CC52BF9.title": "Новые земли"
	"quest.6182DEAE7CC52BF9.quest_desc": [
		"Biomes O' Plenty перекроили местность. Найди нагорье — один из частых новых биомов."
		""
		"Справочник: Мир → Биомы и рельеф (книга — команда /guide)"
	]
	"quest.12407CD08B012646.title": "В данж"
	"quest.12407CD08B012646.quest_desc": [
		"YUNG перестроил данжи — спустись в малый данж."
		""
		"Справочник: Мир → Структуры (книга — команда /guide)"
	]
	"quest.194D6724F8CFF3CD.title": "Лут"
	"quest.194D6724F8CFF3CD.quest_desc": [
		"Открой сундук структуры (Lootr): лут в нём для каждого игрока свой. Отметь квест вручную."
		""
		"Справочник: Мир → Структуры (книга — команда /guide)"
	]
	"quest.73BC533C01D3C40E.title": "Археолог"
	"quest.73BC533C01D3C40E.quest_desc": [
		"Найди первый артефакт в луте — они не крафтятся, только сокровища."
		""
		"Справочник: Искатель приключений → Артефакты (книга — команда /guide)"
	]
	"quest.0FB53BAC62DF6A15.title": "Вечная еда"
	"quest.0FB53BAC62DF6A15.quest_desc": [
		"Бесконечная еда из лута: не тратится, а перезарядка короткая."
		""
		"Справочник: Искатель приключений → Артефакты (книга — команда /guide)"
	]
	"quest.001226C0B7AE3615.title": "Двойной прыжок"
	"quest.001226C0B7AE3615.quest_desc": [
		"Облако в бутылке даёт второй прыжок в воздухе."
		""
		"Справочник: Искатель приключений → Артефакты (книга — команда /guide)"
	]
	"quest.0C6FF851BD661051.title": "Победитель мимика"
	"quest.0C6FF851BD661051.quest_desc": [
		"Сундук оказался мимиком? Убей его."
		""
		"Справочник: Искатель приключений → Артефакты (книга — команда /guide)"
	]
	"quest.4561361D293C50BF.title": "Тёмное железо"
	"quest.4561361D293C50BF.quest_desc": [
		"Слиток тёмного железа крафтят из порчи и железного слитка, а ещё его находят в сундуках склепов и кладбищ."
		""
		"Справочник: Искатель приключений → Боссы и нежить (книга — команда /guide)"
	]
	"quest.687435840E881EA7.title": "Испорченный чемпион"
	"quest.687435840E881EA7.quest_desc": [
